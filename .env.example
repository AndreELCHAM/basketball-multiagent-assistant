# === API Keys (OpenRouter only) ===
OPENROUTER_API_KEY=your_key_here

# === Routing Mode ===
ROUTE_MODE=rag_only              # "rag_only" | "full"

# === Retrieval Config ===
RETRIEVAL_PIPELINE=hybrid        # "dense" | "hybrid" | "rerank"
RETRIEVAL_COLLECTION=markdown_bge_m3
RETRIEVAL_TOP_K=5

# === Models ===
LLM_MODEL=qwen/qwen2.5-72b-instruct
VLM_MODEL=qwen/qwen2.5-vl-72b-instruct
EMBEDDING_DEVICE=cuda            # "cuda" | "cpu"

# === Service URLs (For Docker) ===
QDRANT_PATH=./qdrant_data
QDRANT_URL=http://qdrant:6333
MONGODB_URL=mongodb://mongodb:27017
SYSTEM_B_URL=http://system-b:8001
MCP_RULES_URL=http://mcp-rules-lookup:5001
MCP_FOUL_URL=http://mcp-foul-calculator:5002
