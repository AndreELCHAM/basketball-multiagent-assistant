# === API Keys ===
OPENROUTER_API_KEY=your_openrouter_key_here
GOOGLE_API_KEY=your_google_api_key_here

# === Routing Mode ===
ROUTE_MODE=full                  # "rag_only" | "full"

# === Retrieval Config ===
RETRIEVAL_PIPELINE=hybrid_rerank # "dense" | "hybrid" | "rerank" | "hybrid_rerank"
RETRIEVAL_COLLECTION=markdown_mpnet
RETRIEVAL_TOP_K=5

# === Models ===
LLM_MODEL=qwen/qwen-2.5-72b-instruct
VLM_MODEL=qwen/qwen2.5-vl-72b-instruct
EMBEDDING_DEVICE=cuda            # "cuda" | "cpu"

# === MongoDB ===
MONGODB_DB_NAME=basketball_assistant

# === Service URLs (For Docker) ===
QDRANT_PATH=./qdrant_data
QDRANT_URL=http://qdrant:6333
MONGODB_URL=mongodb://mongodb:27017
SYSTEM_B_URL=http://system-b:8001
MCP_SUSPENSION_URL=http://mcp-suspension-calculator:5002
MCP_PERFORMANCE_URL=http://mcp-performance-calculator:5003
